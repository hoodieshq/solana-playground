# Local Vercel deploy targets. See client-v2/docs/deploy-client-vercel.md.
# Targets assume repo-root cwd (.vercel/ state at root); the built directory is
# forced to $(CLIENT_DIR) below, so the dashboard Root Directory only governs
# the Git-integration deploys.
# `vercel build` reads $(CLIENT_DIR)/vercel.json (installCommand, buildCommand) so install/build chain isn't duplicated here.
# `--archive=tgz` on deploy: the prebuilt output is ~16k files and the upload API
# rejects more than 15000, so the whole tree goes up as one tarball instead.

CLIENT_DIR := client-v2

# The Neon project behind the Vercel Marketplace store `neon-solana-playground`.
NEON_PROJECT_ID := spring-cake-75618686
NEON_BRANCH_URL := NEON_PROJECT_ID=$(NEON_PROJECT_ID) $(CLIENT_DIR)/scripts/neon-preview-branch.sh

# Secrets live in $(CLIENT_DIR)/.env, which dbmate reads by itself. Make does not,
# so the key is lifted out here and exported to every recipe. `?=` leaves an
# already-exported value alone; one key is read rather than the file sourced, so
# a stray DATABASE_URL in there cannot redirect a migration.
NEON_API_KEY ?= $(shell sed -n 's/^NEON_API_KEY=//p' $(CLIENT_DIR)/.env 2>/dev/null | head -1 | tr -d '"'"'"'"')
export NEON_API_KEY

# `--token` is passed only when VERCEL_TOKEN is set; otherwise the CLI uses the
# login from `vercel login`, which a developer already has. A token is for CI.
# Locally it is worse than unnecessary: the only token narrow enough to be safe
# to keep in a shell is project-scoped, and the CLI calls `/v2/user` and
# `/v3/user/tokens/current` on startup, which project-scoped tokens deny -- so a
# required token forced an All Projects token, i.e. org-wide CLI access, to run
# one preview deploy. `$${VAR:+word}` expands to nothing when VAR is unset, and
# the token never reaches the echoed recipe because make prints the text, not
# the value.
VERCEL_TOKEN_ARG = $${VERCEL_TOKEN:+--token=$$VERCEL_TOKEN}

.PHONY: vercel-bootstrap vercel-link-preview vercel-link-production \
	deploy-client-to-vercel-preview deploy-client-to-vercel-production \
	vercel-wasm-cache-store \
	neon-preview-base preview-db-branch migrate-preview-db migrate-parent-db

# The public Blob store that scripts/vercel-install.sh caches built wasm packages in.
WASM_CACHE_STORE := solana-playground-wasm

# Both IDs come from the link file because an exported VERCEL_PROJECT_ID outranks
# it in the CLI's project resolution, leaving orgId unresolved.
VERCEL_IDS = export VERCEL_ORG_ID=$$(jq -r .orgId .vercel/project.json) && \
	export VERCEL_PROJECT_ID=$$(jq -r .projectId .vercel/project.json)

# $(1): Vercel environment to pull (preview | production).
define vercel_link
	@test -f .vercel/project.json || { echo "no .vercel/project.json — run 'make vercel-bootstrap'" >&2; exit 1; }
	$(VERCEL_IDS) && npx vercel@latest pull --yes --environment=$(1) $(VERCEL_TOKEN_ARG)
	@# pull overwrites the cached settings with the dashboard's Root Directory; force ours back.
	@jq --arg dir '$(CLIENT_DIR)' '.settings.rootDirectory = $$dir' \
		.vercel/project.json > .vercel/project.json.next
	@mv .vercel/project.json.next .vercel/project.json
	@echo "Root Directory pinned to $(CLIENT_DIR)"
endef

# Resolve orgId from Vercel API + write .vercel/project.json. Requires jq.
# The one target that still requires VERCEL_TOKEN: this calls the REST API
# directly and a raw request has no stored login to fall back on. A
# project-scoped token is enough here -- /v9/projects/<id> is project-level.
vercel-bootstrap: ## Link the local checkout to the dashboard project (run once; needs VERCEL_TOKEN, VERCEL_PROJECT_ID)
	@: $${VERCEL_TOKEN:?VERCEL_TOKEN is unset}
	@: $${VERCEL_PROJECT_ID:?VERCEL_PROJECT_ID is unset}
	@command -v jq >/dev/null 2>&1 || { echo "jq required — see https://jqlang.org/download/" >&2; exit 1; }
	@# `printf '%s'`, never `echo`: macOS /bin/sh is bash in sh mode with xpg_echo
	@# on, so its echo expands the \n inside the response's JSON strings into real
	@# newlines and hands jq invalid input. The project payload embeds commit
	@# messages, so one multi-line commit is enough to break bootstrap.
	@response=$$(curl -sH "Authorization: Bearer $${VERCEL_TOKEN}" "https://api.vercel.com/v9/projects/$${VERCEL_PROJECT_ID}"); \
		org_id=$$(printf '%s' "$$response" | jq -r '.accountId // empty'); \
		if [ -z "$$org_id" ]; then echo "Bootstrap failed. Vercel API response: $$response" >&2; exit 1; fi; \
		mkdir -p .vercel; \
		jq -n --arg org "$$org_id" --arg proj "$${VERCEL_PROJECT_ID}" '{orgId: $$org, projectId: $$proj}' > .vercel/project.json; \
		echo "Wrote .vercel/project.json"

vercel-link-preview: ## Pull preview env vars from Vercel
	$(call vercel_link,preview)

vercel-link-production: ## Pull production env vars from Vercel
	$(call vercel_link,production)

deploy-client-to-vercel-preview: vercel-link-preview ## Build + deploy a unique preview URL
	$(VERCEL_IDS) && \
		set -a && . ./.vercel/.env.preview.local && set +a && \
		db=$$($(NEON_BRANCH_URL) --pooled) && \
		npx vercel@latest build $(VERCEL_TOKEN_ARG) && \
		npx vercel@latest deploy --prebuilt --archive=tgz \
		-e DATABASE_URL="$$db" $(VERCEL_TOKEN_ARG)

# Builds locally because a Vercel build with no cache exceeds the build time limit.
deploy-client-to-vercel-production: vercel-link-production ## Build locally + deploy to PRODUCTION
	@printf 'Deploy %s @ %s%s to PRODUCTION.\n' \
		"$$(git rev-parse --abbrev-ref HEAD)" "$$(git rev-parse --short HEAD)" \
		"$$(git status --porcelain | grep -q . && echo ' (uncommitted changes included)')"; \
		printf 'Type yes to continue: '; \
		read -r reply || { echo "aborted: no answer on stdin" >&2; exit 1; }; \
		[ "$$reply" = yes ] || { echo "aborted" >&2; exit 1; }
	$(VERCEL_IDS) && \
		set -a && . ./.vercel/.env.production.local && set +a && \
		npx vercel@latest build --prod $(VERCEL_TOKEN_ARG) && \
		npx vercel@latest deploy --prebuilt --prod --archive=tgz $(VERCEL_TOKEN_ARG)

# `--yes` connects the store to the linked project for every environment, which is
# what puts BLOB_STORE_ID into builds. The robots.txt keeps the store's public URLs
# out of search indexes; the store is public so that builds can download without a token.
vercel-wasm-cache-store: ## Create the public Blob store for built wasm packages (run once)
	@test -f .vercel/project.json || { echo "no .vercel/project.json — run 'make vercel-bootstrap'" >&2; exit 1; }
	$(VERCEL_IDS) && npx vercel@latest blob create-store $(WASM_CACHE_STORE) \
		--access public --yes $(VERCEL_TOKEN_ARG)
	$(MAKE) -f $(CLIENT_DIR)/Makefile.vercel vercel-link-production
	@printf 'User-agent: *\nDisallow: /\n' > .vercel/robots.txt
	$(VERCEL_IDS) && set -a && . ./.vercel/.env.production.local && set +a && \
		npx vercel@latest blob put .vercel/robots.txt --pathname robots.txt \
		--access public --allow-overwrite $(VERCEL_TOKEN_ARG)

# The project-level DATABASE_URL is unscoped (no gitBranch) and targets preview
# and production alike, so this migrates production. Previews no longer use it --
# see migrate-preview-db -- but the parent still needs its own schema, and that
# is what this applies. Cutting `preview-base` BEFORE running this is what keeps
# preview branches empty.
migrate-parent-db: vercel-link-preview ## Apply pending migrations to the shared parent database (SERVES PRODUCTION)
	@command -v dbmate >/dev/null 2>&1 || { echo "dbmate required — see $(CLIENT_DIR)/db/README.md" >&2; exit 1; }
	@# DATABASE_URL is the PgBouncer endpoint and carries `channel_binding`, which
	@# dbmate's driver cannot parse. The unpooled URL is direct and still carries
	@# the `sslmode` that both dbmate and src/features/persistence/model/db.mjs
	@# require. An inline DATABASE_URL wins over client-v2/.env, so the local
	@# database is never the one that gets migrated here.
	@url=$$(grep -m1 '^DATABASE_URL_UNPOOLED=' .vercel/.env.preview.local 2>/dev/null | cut -d= -f2- | tr -d '"'); \
		[ -n "$$url" ] || { echo "no DATABASE_URL_UNPOOLED in .vercel/.env.preview.local" >&2; exit 1; }; \
		host=$$(printf '%s\n' "$$url" | sed -E 's#^[^@]*@([^/?]*).*#\1#'); \
		cd $(CLIENT_DIR) || exit 1; \
		status=$$(DATABASE_URL="$$url" dbmate status) || exit 1; \
		printf '%s\n' "$$status"; \
		case "$$status" in *"Pending: 0"*) echo "nothing to apply"; exit 0;; esac; \
		printf 'Apply the migrations marked [ ] above to %s\n' "$$host"; \
		printf 'That database also serves PRODUCTION. Type yes to continue: '; \
		read -r reply || { echo "aborted: no answer on stdin" >&2; exit 1; }; \
		[ "$$reply" = yes ] || { echo "aborted" >&2; exit 1; }; \
		DATABASE_URL="$$url" dbmate --no-dump-schema up

# `preview-base` is the empty parent every preview branch is cut from. Run this
# once, while the shared database still has no schema -- after migrate-parent-db
# it would no longer be empty, and previews would inherit tables that dbmate
# then tries to create again.
neon-preview-base: ## Create the empty parent branch previews are cut from (run once, before migrate-parent-db)
	@: $${NEON_API_KEY:?NEON_API_KEY is unset}
	npx --yes neonctl@latest branches create --name preview-base \
		--project-id $(NEON_PROJECT_ID) --no-secrets

preview-db-branch: ## Create (or reuse) this git branch's Neon branch
	@url=$$($(NEON_BRANCH_URL)) || exit 1; \
		printf '%s\n' "$$url" | sed -E 's#^[^@]*@([^/?]*).*#preview database: \1#'

# No confirmation here, unlike migrate-parent-db: this branch belongs to one git
# branch and nothing else reads it, so a wrong migration costs a `neon branches
# delete` and not an incident.
migrate-preview-db: ## Apply pending migrations to this git branch's own Neon branch
	@command -v dbmate >/dev/null 2>&1 || { echo "dbmate required — see $(CLIENT_DIR)/db/README.md" >&2; exit 1; }
	@url=$$($(NEON_BRANCH_URL)) || exit 1; \
		cd $(CLIENT_DIR) || exit 1; \
		DATABASE_URL="$$url" dbmate status; \
		DATABASE_URL="$$url" dbmate --no-dump-schema up
