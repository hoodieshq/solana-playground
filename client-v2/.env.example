# Copy to .env.local for local dev; set the same names in the Vercel dashboard.
#
# To load into the current shell (note the leading dot - a subshell, and so a
# `make` target, cannot export into the session that called it):
#
#   set -a; . ./.env.local; set +a
#
# `set -a` exports every assignment, which is what child processes need, and
# the shell already ignores `#` lines. To strip comments explicitly instead:
#
#   export $(grep -v '^#' .env.local | xargs)
#
# Prefer the first. `xargs` splits on whitespace, so any value containing a
# space is mangled; and piping through `sed 's/^/export /'` turns the blank
# lines here into a bare `export`, which dumps the whole environment.
#
# Links sit on their own line, never trailing the value: this repo pins
# dotenv@10, which has no inline-comment support, so `KEY=value # note` would
# read the comment as part of the value.
#
# Only REACT_APP_* reaches the browser bundle. Everything else here is read by
# api/*.mjs on the server, which is what keeps the secrets out of the client.

# --- GitHub OAuth App, read by api/github-oauth.mjs ---------------------------
# Register the app, then copy its Client ID. Authorization callback URL must be
# <origin>/api/github-oauth?action=callback -- add one entry per origin you use
# (production and http://localhost:3000).
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
# "Generate a new client secret" on the same page as the ID above.
# https://github.com/settings/developers
GITHUB_CLIENT_SECRET=

# --- Build server ------------------------------------------------------------
# Overrides the endpoint the client builds against. Unset, it falls back to
# localhost:8080 in development and the Foundation server in production.
# https://github.com/solana-playground/solana-playground/tree/master/server
REACT_APP_SERVER_URL=

# --- Explorer MCP server, read by api/mcp.mjs --------------------------------
# The Explorer MCP sits behind Vercel bot protection, so it stays disabled until
# this bypass secret is set. Vercel project -> Settings -> Deployment Protection
# -> Protection Bypass for Automation.
# https://vercel.com/docs/deployment-protection/methods-to-bypass-deployment-protection
MCP_EXPLORER_BYPASS=
# Optional. Defaults to https://explorer.solana.com/mcp when unset.
MCP_EXPLORER_URL=
# Optional. Only needed when the Explorer deployment gates on MCP_ACCESS_KEYS.
MCP_EXPLORER_TOKEN=

# --- Platform RPC endpoints --------------------------------------------------
# All optional. Each one adds a "<Cluster> (Platform)" entry to the endpoint
# picker; the public Solana endpoints stay listed either way. Unset or empty
# vars add nothing.
#
# REACT_APP_DEVNET_RPC_URL doubles as the default endpoint for profiles that
# have not picked one yet. Unset, that default stays api.devnet.solana.com.
#
# Prefer a secured URL whenever the provider offers one. These values ship in
# the public bundle, so a bare `?api-key=` is readable by anyone who loads the
# app and is billable to you until you rotate it. In descending order of
# preference:
#
#   1. A same-origin proxy path, keeping the real keyed URL server-side.
#   2. A provider URL locked to your origin by allowed-domain/referrer rules,
#      so a copied key is useless elsewhere.
#   3. An unrestricted keyed URL - acceptable only for a throwaway key on a
#      low quota, and treat it as already leaked.
#
# https://solana.com/rpc
REACT_APP_DEVNET_RPC_URL=
REACT_APP_TESTNET_RPC_URL=
REACT_APP_MAINNET_RPC_URL=
#
# Sample shape, matching what solana-explorer uses:
#
#   REACT_APP_DEVNET_RPC_URL=https://devnet.helius-rpc.com/?api-key=<YOUR_KEY>
#   REACT_APP_MAINNET_RPC_URL=https://mainnet.helius-rpc.com/?api-key=<YOUR_KEY>
