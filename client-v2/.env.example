# Copy to .env.local for local dev; set the same names in the Vercel dashboard.
#
# Links sit on their own line, never trailing the value: this repo pins
# dotenv@10, which has no inline-comment support, so `KEY=value # note` would
# read the comment as part of the value.
#
# Only REACT_APP_* reaches the browser bundle. Everything else here is read by
# api/*.mjs on the server, which is what keeps the secrets out of the client.

# --- GitHub OAuth App, read by api/github-oauth.mjs ---------------------------
# Register the app, then copy its Client ID. Authorization callback URL must be
# <origin>/api/github-oauth?action=callback -- add one entry per origin you use
# (production and http://localhost:3000).
# https://github.com/settings/developers
GITHUB_CLIENT_ID=
# "Generate a new client secret" on the same page as the ID above.
# https://github.com/settings/developers
GITHUB_CLIENT_SECRET=

# --- Build server ------------------------------------------------------------
# Overrides the endpoint the client builds against. Unset, it falls back to
# localhost:8080 in development and the Foundation server in production.
# https://github.com/solana-playground/solana-playground/tree/master/server
REACT_APP_SERVER_URL=

# --- Explorer MCP server, read by api/mcp.mjs --------------------------------
# The Explorer MCP sits behind Vercel bot protection, so it stays disabled until
# this bypass secret is set. Vercel project -> Settings -> Deployment Protection
# -> Protection Bypass for Automation.
# https://vercel.com/docs/deployment-protection/methods-to-bypass-deployment-protection
MCP_EXPLORER_BYPASS=
# Optional. Defaults to https://explorer.solana.com/mcp when unset.
MCP_EXPLORER_URL=
# Optional. Only needed when the Explorer deployment gates on MCP_ACCESS_KEYS.
MCP_EXPLORER_TOKEN=
